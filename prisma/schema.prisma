datasource db {
  provider = "postgresql"
  url = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  password String? // For credentials auth
  role     String  @default("USER") // ADMIN, USER, PARTNER

  // Identity Info
  firstName    String?
  lastName     String?
  birthYear    Int?
  tcIdentityNo String? @unique

  // Academic Info (string mirrors for display / anonymization; prefer FKs when set)
  university    String?
  programLevel  String? // "Ön Lisans", "Lisans", "Yüksek Lisans", "Doktora"
  faculty       String?
  department    String?
  universityId  String?
  facultyId     String?
  departmentId  String?
  universityLink University? @relation("UserUniversityLink", fields: [universityId], references: [id], onDelete: SetNull)
  facultyLink    Faculty?    @relation("UserFacultyLink", fields: [facultyId], references: [id], onDelete: SetNull)
  departmentLink Department? @relation("UserDepartmentLink", fields: [departmentId], references: [id], onDelete: SetNull)
  studentClass  String?
  studentNumber String? @unique

  // Consents
  marketingConsent Boolean @default(false)

  lastApprovedUploadAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  notes                Note[]
  comments             Comment[]
  noteGrades           NoteGrade[]
  views                View[]
  credits              Int       @default(0) // Süt Bakiyesi (Başlangıç 0 Süt)
  unlockedNotes        UnlockedNote[]
  purchases            ProductPurchase[]
  reports              Report[]
  feedbacks            Feedback[]
  releaseNotes         ReleaseNote[]

  // Store & Partner
  storeId        String?
  store          Store?    @relation(fields: [storeId], references: [id])
  storeTransactions StoreTransaction[]

  // Verification
  studentIdCardUrl String?
  approvalStatus   String    @default("PENDING") // PENDING, APPROVED, REJECTED, BANNED
  rejectionReason  String?
  rejectionCount   Int       @default(0)
  
  isTwoFactorEnabled Boolean @default(false)
  twoFactorConfirmation TwoFactorConfirmation?
  transactions Transaction[]
  chatMessages ChatMessage[]
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorConfirmation {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

model UnlockedNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, noteId])
}

model University {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  users     User[]    @relation("UserUniversityLink")
  notes     Note[]    @relation("NoteUniversityLink")
}

model Faculty {
  id           String       @id @default(cuid())
  name         String       @unique
  departments  Department[]
  users        User[]       @relation("UserFacultyLink")
  notes        Note[]       @relation("NoteFacultyLink")
}

model Department {
  id        String  @id @default(cuid())
  name      String
  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  users     User[]  @relation("UserDepartmentLink")
  notes     Note[]  @relation("NoteDepartmentLink")

  @@unique([facultyId, name])
}

model Note {
  id         String @id @default(cuid())
  title      String
  university String
  faculty    String
  department String
  universityId   String?
  facultyId      String?
  departmentId   String?
  universityLink University? @relation("NoteUniversityLink", fields: [universityId], references: [id], onDelete: SetNull)
  facultyLink    Faculty?    @relation("NoteFacultyLink", fields: [facultyId], references: [id], onDelete: SetNull)
  departmentLink Department? @relation("NoteDepartmentLink", fields: [departmentId], references: [id], onDelete: SetNull)
  fileUrl    String  // Legacy: fallback when no NoteFile records (backward compat)
  price      Int     @default(1) // Notun Süt değeri (1-3)
  status     String  @default("PENDING") // PENDING, APPROVED, REJECTED, SUSPENDED
  rejectionReason String? // Red veya askıya alma sebebi

  // Metadata
  courseName  String?
  type        String? // Ders Notu, İmdat Sorular, etc.
  term        String? // 2025 Güz, etc.
  description String? // User description
  isAI        Boolean @default(false) // İçerikte AI desteği var mı?
  viewCount   Int     @default(0)
  pageCount   Int?    // PDF sayfa sayısı (sadece PDF'ler için) - legacy, first PDF's pageCount
  fileExtension String? // pdf, png, jpg - legacy, first file's extension

  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id])
  
  files      NoteFile[]  // Multi-file support (ordered by sortOrder)
  comments   Comment[]
  grades     NoteGrade[]
  views      View[]
  reports    Report[]
  unlockedBy UnlockedNote[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime? // Soft Delete

  @@index([universityId, departmentId])
  @@index([departmentId])
  @@index([facultyId])
}

model NoteFile {
  id             String   @id @default(cuid())
  noteId         String
  note           Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  fileUrl        String   // Vercel Blob URL
  fileName       String   // Original filename (for extension)
  fileExtension  String   // pdf, jpg, jpeg, png
  sortOrder      Int      @default(0) // Upload order
  pageCount      Int?     // PDF page count only
  createdAt      DateTime @default(now())

  @@index([noteId])
}

model Report {
  id        String   @id @default(cuid())
  reason    String   // Şikayet nedeni (seçilen kutucuk)
  details   String?  // Detaylı açıklama
  status    String   @default("PENDING") // PENDING, RESOLVED, REJECTED

  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum NoteLetterGrade {
  AA
  BA
  BB
  CB
  CC
  DC
  DD
  FD
  FF
}

model NoteGrade {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId    String
  note      Note            @relation(fields: [noteId], references: [id], onDelete: Cascade)
  grade     NoteLetterGrade
  score     Float           // 10 luk skor (AA=10 … FF=1), ortalama için

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, noteId])
  @@index([noteId])
}

model View {
  id        String   @id @default(cuid())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, noteId]) // Bir kullanıcı bir notu (teorik olarak) bir kez "izledi" sayılır
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int      @default(0) // Süt fiyatı
  imageUrl    String?
  isActive    Boolean  @default(true)
  stock       Int?     // null = sınırsız

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases   ProductPurchase[]
}

model ProductPurchase {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  priceAtTime Int    // Satın alma anındaki fiyat

  createdAt DateTime @default(now())
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   // IP or User Identifier
  count     Int      @default(0)
  expiresAt DateTime

  @@unique([key])
  @@index([key])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  topic     String // "Öneri", "Hata Bildirimi", "Şikayet", "Diğer"
  message   String
  imageUrl  String?
  
  status    String   @default("PENDING") // PENDING, REVIEWED, RESOLVED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReleaseNote {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  version     String
  imageUrl    String?
  publishedAt DateTime @default(now())
  
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum TransactionType {
  UPLOAD_REWARD     // Süt kazanımı (Not yükleme)
  NOTE_UNLOCK       // Süt harcaması (Not açma)
  ADMIN_ADJUSTMENT  // Yönetici müdahalesi
  PRODUCT_PURCHASE  // Market harcaması
  REFUND            // İade
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  amount      Int             // Değişim miktarı (+ veya -)
  balanceAfter Int            // İşlem sonrası güncel bakiye (Snapshot)
  type        TransactionType
  description String?
  referenceId String?         // İlgili kayıt ID'si (Note ID, vb.)
  
  createdAt   DateTime        @default(now())

  @@index([userId])
}

model ChatMessage {
  id        String       @id @default(cuid())
  content   String
  createdAt DateTime     @default(now())
  
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  
  parentId  String?
  parent    ChatMessage? @relation("ChatReplies", fields: [parentId], references: [id])
  replies   ChatMessage[] @relation("ChatReplies")

  @@index([userId])
  @@index([createdAt])
}

model Store {
  id          String   @id @default(cuid())
  name        String
  logo        String?
  location    String?
  contactInfo String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  partners    User[]
  products    StoreProduct[]
  transactions StoreTransaction[]
}

model StoreProduct {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  
  title       String
  description String?
  price       Int
  stock       Int      @default(0)
  image       String?
  type        String   @default("PHYSICAL_ITEM") // PHYSICAL_ITEM, COUPON, SERVICE
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions StoreTransaction[]
}

model StoreTransaction {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id])
  
  productId      String
  product        StoreProduct @relation(fields: [productId], references: [id])
  
  cost           Int
  redemptionCode String   @unique // 8-char code
  isRedeemed     Boolean  @default(false)
  redeemedAt     DateTime?
  redeemedBy     String? // User ID of the partner who redeemed it
  
  createdAt      DateTime @default(now())
}
